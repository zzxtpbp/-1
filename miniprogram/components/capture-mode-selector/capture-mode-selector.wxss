.selector {
  display: flex;
  width: 590rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 40rpx;
  background: rgba(24, 24, 25, 0.48);
  box-shadow: 0 18rpx 54rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.mode {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 32rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 25rpx;
  line-height: 72rpx;
  background: transparent;
}

.mode::after { border: 0; }
.mode--active { color: #111111; font-weight: 600; background: rgba(255, 255, 255, 0.92); }
.mode__icon { font-size: 29rpx; }
