page { background: #f6f7f9; }

.collection-page { min-height: 100vh; padding-bottom: calc(env(safe-area-inset-bottom) + 60rpx); color: #151719; }

.nav { display: flex; align-items: center; justify-content: space-between; padding: calc(env(safe-area-inset-top) + 24rpx) 30rpx 22rpx; }
.back { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin: 0; padding: 0 3rpx 4rpx 0; border: 1rpx solid #e0e3e5; border-radius: 50%; color: #1e2022; font-size: 52rpx; font-weight: 300; line-height: 58rpx; background: rgba(255, 255, 255, 0.84); }
.back::after { border: 0; }
.nav__title { position: absolute; left: 50%; display: flex; flex-direction: column; align-items: center; font-size: 28rpx; font-weight: 700; transform: translateX(-50%); }
.nav__subtitle { color: #8a8d90; font-size: 18rpx; font-weight: 500; }
.nav__clear { padding: 12rpx 22rpx; border-radius: 22rpx; color: #d63031; font-size: 22rpx; font-weight: 600; background: rgba(214, 48, 49, 0.08); }
.nav__clear--disabled { opacity: 0.3; }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; padding: 0 60rpx; text-align: center; }
.empty-state__icon { font-size: 120rpx; margin-bottom: 30rpx; }
.empty-state__title { font-size: 32rpx; font-weight: 700; color: #2d3436; margin-bottom: 14rpx; }
.empty-state__desc { color: #8a8d90; font-size: 22rpx; line-height: 1.7; margin-bottom: 40rpx; }
.empty-state__btn {
  padding: 22rpx 60rpx;
  border-radius: 48rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #202326, #3d4246);
  box-shadow: 0 10rpx 24rpx rgba(28, 31, 34, 0.2);
}

/* 单列大卡片 */
.collection-grid { height: calc(100vh - 140rpx); }
.grid-inner { display: flex; flex-direction: column; gap: 28rpx; padding: 10rpx 30rpx; }
.collect-cell {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(25, 29, 32, 0.08);
}
.collect-thumb {
  position: relative;
  width: 100%;
  height: 520rpx;
  background: linear-gradient(135deg, #f5f6f8, #eceef1);
}
.collect-img { width: 100%; height: 100%; }
.collect-type-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.collect-type-tag--object { background: #0984e3; }
.collect-type-tag--color { background: #6c5ce7; }
.collect-type-tag--contour { background: #00b894; }
.collect-meta { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 28rpx 26rpx; }
.collect-time { color: #8a8d90; font-size: 24rpx; font-weight: 500; }
.collect-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #b2b5b8;
  font-size: 24rpx;
  background: rgba(0, 0, 0, 0.05);
}
.collect-color {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
}

.grid-footer {
  text-align: center;
  padding: 30rpx 0 60rpx;
  color: #c5c8ca;
  font-size: 18rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}
